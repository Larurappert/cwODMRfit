def find_positions(base_folder):
    if not os.path.exists(base_folder):
        return []
    positions = []
    for item in os.listdir(base_folder):
        item_path = os.path.join(base_folder, item)
        if not os.path.isdir(item_path):
            continue
        m = re.search(r"po[\s_-]?(\d+)", item, re.IGNORECASE)
        if m:
            pos_number = int(m.group(1))
            positions.append((pos_number, item_path))
    positions.sort(key=lambda x: x[0])
    return positions



def choose_contrast_result(results_by_power: dict):
    def valid(res):
        if res is None:
            return False
        r2_val = res.get("r2", np.nan)
        return (np.isfinite(r2_val) and (r2_val >= R2_MIN))

    # preferred
    if CONTRAST_POWER_PRIMARY in results_by_power and valid(results_by_power[CONTRAST_POWER_PRIMARY]):
        return CONTRAST_POWER_PRIMARY, results_by_power[CONTRAST_POWER_PRIMARY]

    # fallback
    if CONTRAST_POWER_FALLBACK in results_by_power and valid(results_by_power[CONTRAST_POWER_FALLBACK]):
        return CONTRAST_POWER_FALLBACK, results_by_power[CONTRAST_POWER_FALLBACK]

    # any
    for p in sorted(results_by_power.keys()):
        if valid(results_by_power[p]):
            return p, results_by_power[p]

    return None, {}


def process_position(position_folder):
    files = glob.glob(os.path.join(position_folder, "*range0.dat"))
    if len(files) == 0:
        print("  WARNING: no files found")
        return None

    print(f"  Found: {len(files)} files")

    results_by_power = {}
    for f in files:
        bn = os.path.basename(f).lower()
        m = re.search(r"([+-]?\d+)\s?dbm", bn)
        if not m:
            continue
        power = float(m.group(1))

        print(f"    {power:>4.0f} dBm: ", end="")
        res = fit_single_odmr_file(f, FIT_MIN, FIT_MAX, verbose=False)
        if res is None:
            print("FAIL")
            continue

        r2_val = res.get("r2", np.nan)
        if (not np.isfinite(r2_val)) or (r2_val < R2_MIN):
            print(f"REJECT (R²={r2_val:.3f} < {R2_MIN:.2f})")
            continue

        results_by_power[power] = res
        print(f"OK  E⊥={res['transverse_mhz']:.2f} MHz, Ez={res['axial_mhz']:+.2f} MHz, R²={r2_val:.3f}")

    if len(results_by_power) == 0:
        return None

    # Aggregate across selected powers  (only the ones that cam by quality cut)
    axial_vals  = [results_by_power[p]["axial_mhz"] for p in POWERS_FOR_STRAIN if p in results_by_power]
    axial_errs  = [results_by_power[p]["axial_mhz_err"] for p in POWERS_FOR_STRAIN if p in results_by_power]
    trans_vals  = [results_by_power[p]["transverse_mhz"] for p in POWERS_FOR_STRAIN if p in results_by_power]
    trans_errs  = [results_by_power[p]["transverse_mhz_err"] for p in POWERS_FOR_STRAIN if p in results_by_power]

    axial_mean, axial_mean_err_w = weighted_mean(axial_vals, axial_errs)
    trans_mean, trans_mean_err_w = weighted_mean(trans_vals, trans_errs)

    axial_std_over_powers = np.std(axial_vals) if len(axial_vals) > 1 else 0.0
    trans_std_over_powers = np.std(trans_vals) if len(trans_vals) > 1 else 0.0

    axial_mean_err = conservative_err(axial_mean_err_w, axial_std_over_powers)
    trans_mean_err = conservative_err(trans_mean_err_w, trans_std_over_powers)

    # T2/quality metrics at chosen power (fallback: any surviving power)
    res_q = results_by_power.get(POWER_FOR_T2, None)
    if res_q is None:
        res_q = list(results_by_power.values())[0]

    splitting_mhz_q = res_q.get("splitting_mhz", np.nan)
    splitting_mhz_q_err = res_q.get("splitting_mhz_err", np.nan)

    # >>> NEW: contrast selection with per-position fallback (0 -> -5)
    contrast_power_used, res_c = choose_contrast_result(results_by_power)
    baseline_counts = res_c.get("baseline_counts", np.nan)

    return {
        "axial_mhz": axial_mean,
        "axial_mhz_err": axial_mean_err,
        "axial_std_over_powers": axial_std_over_powers,

        "transverse_mhz": trans_mean,                # E = splitting/2
        "transverse_mhz_err": trans_mean_err,
        "trans_std_over_powers": trans_std_over_powers,

        "splitting_mhz_q": splitting_mhz_q,
        "splitting_mhz_q_err": splitting_mhz_q_err,

        "strain_n": len(trans_vals),

        "contrast": res_c.get("contrast", np.nan),
        "dip_asym": res_c.get("dip_asym", np.nan),
        "dip_ratio": res_c.get("dip_ratio", np.nan),
        "contrast_power_used": float(contrast_power_used) if contrast_power_used is not None else np.nan,

        "baseline": baseline_counts,

        "r2": res_q.get("r2", np.nan),
        "chi2": res_q.get("chi2", np.nan),
        "chi2_poiss": res_q.get("chi2_poiss", np.nan),

        "n_powers": len(results_by_power),
    }



