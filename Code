def fit_and_plot_file(filepath):
    """
    Fit one ODMR file and automatically plot:
    - data + fit
    - residuals
    - vertical lines at dip centers
    """

    res = fit_single_odmr_file(
        filepath,
        fit_min=FIT_MIN,
        fit_max=FIT_MAX,
        verbose=True
    )

    if res is None:
        print("Fit failed.")
        return None

    print("\n=== SINGLE FILE FIT RESULT ===")
    print(f"File: {filepath}")
    print(f"R²: {res['r2']:.4f}")
    print(f"Ez (axial): {res['axial_mhz']:+.3f} ± {res['axial_mhz_err']:.3f} MHz")
    print(f"E⊥ (transverse): {res['transverse_mhz']:+.3f} ± {res['transverse_mhz_err']:.3f} MHz")
    print(f"Splitting: {res['splitting_mhz']:.3f} ± {res['splitting_mhz_err']:.3f} MHz")
    print(f"Contrast: {res['contrast']:.2f} %")
    print(f"T2* (Gauss proxy): {res['T2_gauss']:.3f} µs")
    print(f"chi2_red: {res['chi2']:.3g}")
    print(f"chi2_poiss: {res['chi2_poiss']:.3g}")

    # Dip centers 
    c1 = res["c1"]
    c2 = res["c2"]

    # fit+plots
    fig, ax = setup_plot_style(
        figsize=(4.6, 2.8),
        dpi=200,
        x_decimals=4,
        y_decimals=3,
        nbins=6,
        use_grid=False
    )

    ax.plot(res["x"], res["y"], ".", label="data")
    ax.plot(res["x"], res["fit"], "-", label="fit")

    # vertical dip markers for better look
    if np.isfinite(c1):
        ax.axvline(c1, linestyle="--", linewidth=0.5, color =  "#8C5CB3" )
    if np.isfinite(c2):
        ax.axvline(c2, linestyle="--", linewidth=0.5, color =  "#8C5CB3")

    finalize_plot(
        fig, ax,
        xlabel="Frequency (GHz)",
        ylabel="Normalized counts" if NORMALIZE_TO_BASELINE else "Counts",
        title="Single ODMR fit",
        show_legend=True,
        legend_loc="upper right",
        legend_ncol=1
    )
    plt.show()

    fig, ax = setup_plot_style(
        figsize=(4.6, 2.1),
        dpi=200,
        x_decimals=4,
        y_decimals=4,
        nbins=6,
        use_grid=False
    )

    ax.axhline(0, linewidth=1)
    ax.plot(res["x"], res["residuals"], ".")

    finalize_plot(
        fig, ax,
        xlabel="Frequency (GHz)",
        ylabel="Residual",
        title="Residuals",
        show_legend=False
    )
    plt.show()

    return res


