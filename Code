def mhz_to_ghz(x_mhz):
    return x_mhz / 1e3


def eps_par_from_deltaD_mhz(deltaD_mhz):
    if not np.isfinite(deltaD_mhz):
        return np.nan
    return mhz_to_ghz(deltaD_mhz) / D_PAR_GHZ_PER_STRAIN


def eps_perp_from_deltaE_mhz(deltaE_mhz):
    if not np.isfinite(deltaE_mhz):
        return np.nan
    return mhz_to_ghz(deltaE_mhz) / D_PERP_GHZ_PER_STRAIN


def sigma_mpa_from_eps(eps):
    if not np.isfinite(eps):
        return np.nan
    return (C_EFF_PA * eps) / 1e6


def eps_hydro(eps_par, eps_perp):
    if not (np.isfinite(eps_par) and np.isfinite(eps_perp)):
        return np.nan
    return (eps_par + 2.0 * eps_perp) / 3.0


def u_eff_j_m3_from_delta_eps(delta_eps_par, delta_eps_perp):
    if not (np.isfinite(delta_eps_par) and np.isfinite(delta_eps_perp)):
        return np.nan
    return 0.5 * C_EFF_PA * (delta_eps_par**2 + 2.0 * delta_eps_perp**2)


def eps_err_from_mhz_err(delta_mhz_err, coupling_ghz_per_strain):
    if not np.isfinite(delta_mhz_err) or delta_mhz_err < 0:
        return np.nan
    return mhz_to_ghz(delta_mhz_err) / coupling_ghz_per_strain


def u_err_from_delta_eps(delta_eps_par, delta_eps_perp, delta_eps_par_err, delta_eps_perp_err):
    if not (np.isfinite(delta_eps_par) and np.isfinite(delta_eps_perp)
            and np.isfinite(delta_eps_par_err) and np.isfinite(delta_eps_perp_err)):
        return np.nan
    du2 = (C_EFF_PA * delta_eps_par)**2 * (delta_eps_par_err**2) + (2.0 * C_EFF_PA * delta_eps_perp)**2 * (delta_eps_perp_err**2)
    return float(np.sqrt(du2))




# Reference for axial shift:
D_GS_GHZ = 2.870  # GHz

# Fit-Window
FIT_MIN = 2.858   # GHz
FIT_MAX = 2.883   # GHz


NORMALIZE_TO_BASELINE = True
USE_POISSON_CHI2 = True


EXPECTED_C0_GHZ = 2.8705      # expected midpoint (used as anchor/fallback)
MAX_SPLITTING_MHZ = 6.0       # HARD physical/expected cap (splitting = |c2-c1|)
MIN_SPLITTING_MHZ = 0.2

# Extra guard to make sure it actually works and doesnt fail in the harder cases like Lotta 
C2_UPPER_GHZ = 2.874

# Quality:
MIN_CONTRAST_PERCENT = 0.02


#FIt Model used 
def voigt_dip(freq, amp, center, sigma, gamma):
    prof = voigt_profile(freq - center, sigma, gamma)
    prof_max = voigt_profile(0.0, sigma, gamma)
    return amp * prof / prof_max


def model_voigt_c0d(freq, A1, c0, d, s1, g1, A2, s2, g2, b0, slope):
   
    c1 = c0 - d
    c2 = c0 + d
    base = b0 + slope * (freq - c0)
    d1 = voigt_dip(freq, A1, c1, s1, g1)
    d2 = voigt_dip(freq, A2, c2, s2, g2)
    return base - d1 - d2


