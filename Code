def finite_mask(*arrs):
    m = np.ones_like(np.asarray(arrs[0]), dtype=bool)
    for a in arrs:
        a = np.asarray(a)
        m &= np.isfinite(a)
    return m


def weighted_mean(values, sigmas):
    """
    Inverse-variance weighted mean.
    Returns (mean, sigma_mean). Falls back to simple mean if sigmas invalid.
    """
    v = np.asarray(values, dtype=float)
    s = np.asarray(sigmas, dtype=float)

    m = np.isfinite(v) & np.isfinite(s) & (s > 0)
    if np.sum(m) >= 1:
        w = 1.0 / (s[m] ** 2)
        mu = np.sum(w * v[m]) / np.sum(w)
        sigma_mu = np.sqrt(1.0 / np.sum(w))
        return float(mu), float(sigma_mu)

    m2 = np.isfinite(v)
    if np.sum(m2) == 0:
        return np.nan, np.nan
    mu = float(np.mean(v[m2]))
    sigma_mu = float(np.std(v[m2])) if np.sum(m2) > 1 else np.nan
    return mu, sigma_mu


def conservative_err(pcov_err, std_over_powers):
    """
    pcov_err from curve_fit can be overly optimistic.
    thesis-safe: err_final = max(pcov_err, std_over_powers)
    """
    candidates = []
    if np.isfinite(pcov_err) and pcov_err > 0:
        candidates.append(float(pcov_err))
    if np.isfinite(std_over_powers) and std_over_powers > 0:
        candidates.append(float(std_over_powers))
    if not candidates:
        return np.nan
    return float(np.max(candidates))


def set_y_limits_with_errorbars(ax, y_list, yerr_list=None,
                               pad_low_frac=0.12, pad_high_frac=0.80,
                               manual_limits=None):
    """
    Includes all points + errorbars; adds extra headroom above.
    """
    if manual_limits is not None:
        ax.set_ylim(*manual_limits)
        return

    ymins, ymaxs = [], []

    if yerr_list is None:
        yerr_list = [None] * len(y_list)

    for y, ye in zip(y_list, yerr_list):
        if y is None:
            continue
        y = np.asarray(y, dtype=float)
        mask = np.isfinite(y)

        if ye is not None:
            ye = np.asarray(ye, dtype=float)
            mask &= np.isfinite(ye)
            if np.any(mask):
                y_low = y[mask] - np.abs(ye[mask])
                y_high = y[mask] + np.abs(ye[mask])
                ymins.append(np.min(y_low))
                ymaxs.append(np.max(y_high))
        else:
            if np.any(mask):
                ymins.append(np.min(y[mask]))
                ymaxs.append(np.max(y[mask]))

    if not ymins or not ymaxs:
        return

    ymin = float(np.min(ymins))
    ymax = float(np.max(ymaxs))

    yr = ymax - ymin
    if yr <= 0:
        yr = max(abs(ymax), 1.0)

    ax.set_ylim(ymin - pad_low_frac * yr, ymax + pad_high_frac * yr)


