def _apply_rcparams(font_size: int):
    mpl.rcParams.update({
        "font.size": font_size,
        "axes.labelsize": font_size,
        "axes.titlesize": font_size + 1,
        "xtick.labelsize": font_size - 1,
        "ytick.labelsize": font_size - 1,
        "legend.fontsize": font_size - 1,
        "font.family": "sans-serif",
        "font.sans-serif": ["Arial", "DejaVu Sans", "Helvetica"],
    })


def setup_plot_style(
    figsize=(3.5, 2.5),
    font_size=9,
    use_grid=False,
    dpi=300,
    x_decimals=3,
    y_decimals=2,
    nbins=6,
):
    _apply_rcparams(font_size)

    plt.style.use("seaborn-v0_8-white")
    fig, ax = plt.subplots(figsize=figsize, dpi=dpi)

    ax.set_prop_cycle(color=CUSTOM_COLORS)

    for s in ["top", "right", "bottom", "left"]:
        ax.spines[s].set_visible(True)

    ax.tick_params(
        which="major",
        direction="in",
        length=4,
        width=0.8,
        top=True,
        bottom=True,
        left=True,
        right=True,
        labeltop=False,
        labelright=False,
    )

    ax.minorticks_on()
    ax.tick_params(
        which="minor",
        direction="in",
        length=2,
        width=0.6,
        top=True,
        bottom=True,
        left=True,
        right=True,
    )

    ax.xaxis.set_minor_locator(AutoMinorLocator(2))
    ax.yaxis.set_minor_locator(AutoMinorLocator(2))

    ax.xaxis.set_major_formatter(FormatStrFormatter(f"%.{x_decimals}f"))
    ax.yaxis.set_major_formatter(FormatStrFormatter(f"%.{y_decimals}f"))

    ax.xaxis.set_major_locator(MaxNLocator(nbins=nbins))
    ax.yaxis.set_major_locator(MaxNLocator(nbins=nbins))

    ax.grid(use_grid)
    return fig, ax


def finalize_plot(
    fig,
    ax,
    xlabel="",
    ylabel="",
    title="",
    show_legend=True,
    legend_loc="upper left",
    legend_ncol=2,
):
    if xlabel:
        ax.set_xlabel(xlabel)
    if ylabel:
        ax.set_ylabel(ylabel)
    if title:
        ax.set_title(title)

    if show_legend:
        legend = ax.legend(
            loc=legend_loc,
            frameon=True,
            fancybox=True,
            shadow=False,
            framealpha=0.35,
            ncol=legend_ncol,
        )
        legend.get_frame().set_facecolor("0.98")
        legend.get_frame().set_edgecolor("0.35")
        legend.get_frame().set_linewidth(0.8)

    fig.tight_layout()
    return fig, ax


