def fit_single_odmr_file(filename, fit_min=FIT_MIN, fit_max=FIT_MAX, verbose=False):
   
    basename = os.path.basename(filename)

    try:
        # ---------- load (robust) ----------
        data = None
        for skip in [22, 20, 18, 24, 26, 0]:
            try:
                data_try = np.loadtxt(filename, skiprows=skip)
                if data_try.ndim == 2 and data_try.shape[1] >= 2 and len(data_try) > 50:
                    data = data_try
                    break
            except Exception:
                continue

        if data is None:
            if verbose:
                print(f"[{basename}] WARNING: file format not recognized")
            return None

        frequency = data[:, 0] / 1e9  # GHz
        counts_raw = data[:, 1]

        # ---------- baseline normalize ----------
        N_base = max(5, int(0.1 * len(counts_raw)))
        baseline = np.mean(counts_raw[:N_base])
        if baseline == 0 or not np.isfinite(baseline):
            baseline = np.mean(counts_raw)

        counts = (counts_raw / baseline) if NORMALIZE_TO_BASELINE else counts_raw.copy()

        # ---------- fit window ----------
        mask = (frequency >= fit_min) & (frequency <= fit_max)
        x = frequency[mask]
        y = counts[mask]
        counts_raw_fit = counts_raw[mask]

        if len(x) < 10:
            if verbose:
                print(f"[{basename}] WARNING: too few points in fit window ({len(x)})")
            return None

        # ---------- smoothing ----------
        win_len = min(11, len(y)//2*2 - 1)
        if win_len < 5:
            win_len = 5 if len(y) >= 5 else max(3, len(y) - (1 - len(y) % 2))
        y_smooth = savgol_filter(y, window_length=win_len, polyorder=2) if win_len >= 3 else y.copy()

        # ---------- dip finding ----------
        amp = float(np.max(y_smooth) - np.min(y_smooth))
        if amp <= 0 or not np.isfinite(amp):
            amp = float(np.max(y_smooth))

        peaks = None
        for rel_prom in [0.2, 0.1, 0.05, 0.02, 0.01]:
            try:
                peaks_try, _ = find_peaks(-y_smooth, prominence=rel_prom * amp, distance=3)
            except Exception:
                peaks_try = np.array([], dtype=int)
            if len(peaks_try) >= 2:
                peaks = peaks_try
                break

        # fallback: take two lowest points (still may be garbage in single-dip data)
        if peaks is None or len(peaks) < 2:
            idx_sorted = np.argsort(y_smooth)
            if len(idx_sorted) >= 2:
                peaks = np.sort(idx_sorted[:2])
            else:
                peaks = np.array([], dtype=int)

        # Build c0/d guesses
        if len(peaks) >= 2:
            if len(peaks) > 2:
                peaks = peaks[np.argsort(y_smooth[peaks])[:2]]
            peaks = np.sort(peaks)

            c_guess_1 = float(x[peaks[0]])
            c_guess_2 = float(x[peaks[1]])

            dx = float(np.median(np.diff(x))) if len(x) > 1 else 0.0005
            if abs(c_guess_2 - c_guess_1) < 2 * dx:
                mid = 0.5 * (c_guess_1 + c_guess_2)
                c_guess_1 = mid - 1.5 * dx
                c_guess_2 = mid + 1.5 * dx

            c0_guess = 0.5 * (c_guess_1 + c_guess_2)
            d_guess = 0.5 * abs(c_guess_2 - c_guess_1)
        else:
            # hard anchor fallback (your guidance)
            c0_guess = float(np.clip(EXPECTED_C0_GHZ, fit_min, fit_max))
            d_guess = 0.0015  # 3 MHz splitting

        # ---------- initial guesses ----------
        b0_guess = float(np.percentile(y, 90))
        if not np.isfinite(b0_guess) or b0_guess <= 0:
            b0_guess = float(np.max(y))

        slope_guess = (y[-1] - y[0]) / (x[-1] - x[0]) if x[-1] != x[0] else 0.0

        if len(peaks) >= 2:
            dip_depth_1 = b0_guess - float(y_smooth[peaks[0]])
            dip_depth_2 = b0_guess - float(y_smooth[peaks[1]])
        else:
            dip_depth_1 = b0_guess - float(np.min(y_smooth))
            dip_depth_2 = dip_depth_1

        A1_guess = max(dip_depth_1, b0_guess * 0.01, 1e-3)
        A2_guess = max(dip_depth_2, b0_guess * 0.01, 1e-3)

        width_est = max(d_guess / 3.0, 0.0003)  # GHz
        s1_guess = float(np.clip(width_est, 0.0003, 0.01))
        g1_guess = float(np.clip(width_est, 0.0003, 0.01))
        s2_guess = s1_guess
        g2_guess = g1_guess

        # ---------- bounds (HARD enforce splitting <= 6 MHz) ----------
        # splitting = 2d -> d_max = (MAX_SPLITTING_MHZ/2) in MHz -> /1000 to GHz
        d_max_ghz = (MAX_SPLITTING_MHZ / 2.0) / 1e3  # 6 MHz -> 0.003 GHz
        d_max_ghz = float(np.clip(d_max_ghz, 0.0005, 0.03))

        # params: A1, c0, d, s1, g1, A2, s2, g2, b0, slope
        lb = [
            0.0,      fit_min,  0.0,        0.0001, 0.0001,
            0.0,      0.0001,   0.0001,     0.0,    -200.0
        ]
        ub = [
            b0_guess * 10.0,  fit_max,  d_max_ghz,  0.03,   0.03,
            b0_guess * 10.0,  0.03,     0.03,       b0_guess * 5.0,  200.0
        ]

        # clip guesses into bounds
        c0_guess = float(np.clip(c0_guess, fit_min, fit_max))
        d_guess = float(np.clip(d_guess, 0.0001, 0.95 * d_max_ghz))
        slope_guess = float(np.clip(slope_guess, lb[-1] * 0.9, ub[-1] * 0.9))

        p0 = [
            A1_guess, c0_guess, d_guess, s1_guess, g1_guess,
            A2_guess, s2_guess, g2_guess,
            b0_guess, slope_guess
        ]

        def attempt_fit(p0_local, maxfev=250000):
            popt, pcov = curve_fit(
                model_voigt_c0d, x, y, p0=p0_local,
                bounds=(lb, ub),
                maxfev=maxfev,
                ftol=1e-8, xtol=1e-8
            )
            return popt, pcov

        # ---------- fit with fallback anchored at EXPECTED_C0_GHZ ----------
        try:
            popt, pcov = attempt_fit(p0)
        except Exception:
            c0_fb = float(np.clip(EXPECTED_C0_GHZ, fit_min, fit_max))
            d_fb = float(min(0.0015, 0.95 * d_max_ghz))
            A_fb = max(0.01 * b0_guess, 1e-2)
            p0_fb = [A_fb, c0_fb, d_fb, 0.001, 0.001,
                     A_fb, 0.001, 0.001,
                     b0_guess, 0.0]
            try:
                popt, pcov = attempt_fit(p0_fb)
            except Exception:
                return None

        (A1, c0, d, s1, g1, A2, s2, g2, b0, slope) = popt
        c1 = c0 - d
        c2 = c0 + d

        # ---------- diagnostics ----------
        fit_curve = model_voigt_c0d(x, *popt)
        residuals = y - fit_curve

        ss_res = np.sum(residuals**2)
        ss_tot = np.sum((y - np.mean(y))**2)
        r_square = 1 - (ss_res / ss_tot) if ss_tot > 0 else np.nan
        dof = max(len(x) - len(popt), 1)
        chi2_red = ss_res / dof

        chi2_poisson = np.nan
        if USE_POISSON_CHI2:
            scale_back = baseline if NORMALIZE_TO_BASELINE else 1.0
            model_raw = fit_curve * scale_back
            data_raw = counts_raw_fit
            sigma_p = np.sqrt(np.clip(data_raw, 1.0, None))
            chi2_poisson = np.sum(((data_raw - model_raw) / sigma_p) ** 2) / dof

        # widths / T2*
        fwhm_g1 = 2.355 * s1 * 1e3
        fwhm_g2 = 2.355 * s2 * 1e3
        fwhm_l1 = 2.0 * g1 * 1e3
        fwhm_l2 = 2.0 * g2 * 1e3

        def safe_T2_from_fwhm(fwhm_mhz):
            if fwhm_mhz <= 0 or not np.isfinite(fwhm_mhz):
                return np.nan
            return 1.0 / (np.pi * fwhm_mhz * 1e6) * 1e6  # µs

        T2_gauss = np.nanmean([safe_T2_from_fwhm(fwhm_g1), safe_T2_from_fwhm(fwhm_g2)])
        T2_lorentz = np.nanmean([safe_T2_from_fwhm(fwhm_l1), safe_T2_from_fwhm(fwhm_l2)])

        D_eff = float(c0)
        splitting_mhz = float(2.0 * d * 1e3)
        transverse_mhz = float(d * 1e3)           # E = splitting/2
        axial_mhz = float((D_eff - D_GS_GHZ) * 1e3)

        # contrast/asymmetry
        mean_contrast = ((A1 + A2) / (2 * b0)) * 100 if b0 != 0 else np.nan
        A_low, A_high = (min(A1, A2), max(A1, A2))
        denomA = (A_high + A_low)
        dip_asym = (A_high - A_low) / denomA if denomA > 0 else np.nan
        dip_ratio = (A_high / A_low) if (A_low > 0 and np.isfinite(A_low)) else np.nan

        denom_gl = (fwhm_l1 + fwhm_l2)
        gl_ratio = (fwhm_g1 + fwhm_g2) / denom_gl if denom_gl > 0 else np.nan

        var_c0 = float(pcov[1, 1]) if (pcov is not None and np.isfinite(pcov[1, 1])) else np.nan
        var_d  = float(pcov[2, 2]) if (pcov is not None and np.isfinite(pcov[2, 2])) else np.nan

        axial_mhz_err = (1e3 * np.sqrt(var_c0)) if np.isfinite(var_c0) and var_c0 >= 0 else np.nan
        transverse_mhz_err = (1e3 * np.sqrt(var_d)) if np.isfinite(var_d) and var_d >= 0 else np.nan
        splitting_mhz_err = (2e3 * np.sqrt(var_d)) if np.isfinite(var_d) and var_d >= 0 else np.nan

        bad = False
        bad_reasons = []

        if not np.isfinite(c0) or not np.isfinite(d):
            bad = True
            bad_reasons.append("non-finite c0/d")

        if (c2 > C2_UPPER_GHZ):
            bad = True
            bad_reasons.append(f"c2={c2:.6f} > {C2_UPPER_GHZ:.6f} GHz")

        if (splitting_mhz < MIN_SPLITTING_MHZ) or (splitting_mhz > MAX_SPLITTING_MHZ):
            bad = True
            bad_reasons.append(f"splitting={splitting_mhz:.3f} MHz out of [{MIN_SPLITTING_MHZ},{MAX_SPLITTING_MHZ}]")

        if np.isfinite(mean_contrast) and (mean_contrast < MIN_CONTRAST_PERCENT):
            bad = True
            bad_reasons.append(f"contrast={mean_contrast:.4f}% < {MIN_CONTRAST_PERCENT}%")

        if bad:
            if verbose:
                print(f"[{basename}] FAILOVER (keep axial only). Reasons: " + "; ".join(bad_reasons))
            transverse_mhz = np.nan
            transverse_mhz_err = np.nan
            splitting_mhz = np.nan
            splitting_mhz_err = np.nan
            c1 = np.nan
            c2 = np.nan

        return {
            "axial_mhz": axial_mhz,
            "axial_mhz_err": axial_mhz_err,

            "transverse_mhz": transverse_mhz,
            "transverse_mhz_err": transverse_mhz_err,

            "splitting_mhz": splitting_mhz,
            "splitting_mhz_err": splitting_mhz_err,

            "contrast": mean_contrast,
            "dip_asym": dip_asym,
            "dip_ratio": dip_ratio,

            "D_eff": D_eff,
            "T2_gauss": T2_gauss,
